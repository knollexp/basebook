# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Only write actions need a key. Everything that reads works without one.
BASEBOOK_PRIVATE_KEY=

# Optional. The public endpoint rate-limits bursts, which surfaces as calls
# returning no data. Point this at your own endpoint if you script the CLI.
# BASEBOOK_RPC_URL=

# Optional. Defaults to base.
# BASEBOOK_NETWORK=base
