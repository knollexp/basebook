{
  "name": "basebook",
  "version": "0.1.0",
  "description": "A CLI for the eleven base-contracts deployed on Base",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "node scripts/gen-docs.js"
  },
  "keywords": [
    "base",
    "ethereum",
    "cli",
    "ethers",
    "smart-contracts"
  ],
  "author": "Sebastian (knollexp)",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "bin": {
    "basebook": "bin/basebook.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knollexp/basebook.git"
  },
  "bugs": {
    "url": "https://github.com/knollexp/basebook/issues"
  },
  "homepage": "https://github.com/knollexp/basebook#readme",
  "files": [
    "bin",
    "src",
    "abi"
  ]
